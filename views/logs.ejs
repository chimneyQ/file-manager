<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>访问日志</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/fontawesome.min.css">
  <link rel="stylesheet" href="/css/logs.css">
</head>
<body class="log-page <%= darkMode ? 'dark-mode' : '' %>">
<div class="container">

  <header class="log-header">
    <div class="logo"><i class="fas fa-clipboard-list"></i><span>访问日志</span></div>
    <div class="header-actions">
      <a href="/" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> 返回</a>
      <a href="/logout" class="btn btn-secondary"><i class="fas fa-sign-out-alt"></i> 退出</a>
    </div>
  </header>

  <section class="log-stats">
    <div class="stat-card">
      <div class="stat-icon visits"><i class="fas fa-list"></i></div>
      <div class="stat-label">总访问次数</div>
      <div class="stat-value"><%= total %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon devices"><i class="fas fa-desktop"></i></div>
      <div class="stat-label">独立设备数</div>
      <div class="stat-value"><%= uniqueDeviceCount %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon today"><i class="fas fa-eye"></i></div>
      <div class="stat-label">已显示 / 总计</div>
      <div class="stat-value"><%= offset + logs.length %> / <%= total %></div>
    </div>
  </section>

  <% if (typeof downloadRanking !== 'undefined' && downloadRanking.length > 0) { %>
  <div class="download-ranking">
    <h4><i class="fas fa-download"></i> 下载排行榜 Top 10</h4>
    <div class="ranking-list">
      <% downloadRanking.slice(0, 10).forEach(function(item, idx) { %>
      <div class="ranking-item">
        <span class="ranking-index"><%= idx + 1 %>.</span>
        <span class="ranking-path" title="<%= item.path %>"><%= item.path %></span>
        <span class="ranking-count"><%= item.count %> 次</span>
      </div>
      <% }); %>
    </div>
  </div>
  <% } %>

  <div class="download-ranking" id="regionCard" style="display:none">
    <h4><i class="fas fa-globe-asia"></i> 地域分布 <span style="font-weight:400;font-size:12px;color:#909399;">（点击地区 = 只看该地区的访问）</span></h4>
    <div class="ranking-list" id="regionList"></div>
  </div>
  <section class="log-toolbar">
    <div class="toolbar-filters">
      <select id="dateFilter" onchange="changeDate(this.value)">
        <option value="all" <%= dateFilter === 'all' ? 'selected' : '' %>>全部日志</option>
        <option value="today" <%= dateFilter === 'today' ? 'selected' : '' %>>今天</option>
        <option value="yesterday" <%= dateFilter === 'yesterday' ? 'selected' : '' %>>昨天</option>
        <option value="week" <%= dateFilter === 'week' ? 'selected' : '' %>>最近7天</option>
        <option value="month" <%= dateFilter === 'month' ? 'selected' : '' %>>最近30天</option>
      </select>
      <% if (typeof opBreakdown !== 'undefined' && opBreakdown && Object.keys(opBreakdown).length > 0) { %>
      <select id="opFilter" onchange="filterByOp(this.value)">
        <option value="all">全部操作</option>
        <% Object.keys(opBreakdown).forEach(function(op) { %>
        <option value="<%= op %>"><%= op %></option>
        <% }); %>
      </select>
      <% } %>
      <input type="search" id="searchBox" placeholder="搜索 IP 或路径（回车全量搜索）" value="<%= q %>" oninput="filterBySearch(this.value)" onkeydown="if(event.key==='Enter'){searchAll();}">
      <label class="only-error-toggle" style="display:inline-flex;align-items:center;gap:6px;padding:0 10px;height:38px;border:1px solid #dcdfe6;border-radius:8px;font-size:13px;cursor:pointer;user-select:none;white-space:nowrap;"><input type="checkbox" style="margin:0;cursor:pointer;" <%= onlyError ? 'checked' : '' %> onchange="toggleOnlyError(this.checked)"> 只看异常</label>
      <label class="only-error-toggle" style="display:inline-flex;align-items:center;gap:6px;padding:0 10px;height:38px;border:1px solid #dcdfe6;border-radius:8px;font-size:13px;cursor:pointer;user-select:none;white-space:nowrap;"><input type="checkbox" style="margin:0;cursor:pointer;" <%= showApi ? 'checked' : '' %> onchange="toggleShowApi(this.checked)"> 显示接口请求<% if (apiCount > 0 && !showApi) { %><span style="color:#f56c6c;margin-left:4px;">已隐藏 <%= apiCount %> 条</span><% } %></label>
    </div>
    <div class="toolbar-actions">
      <button onclick="expandAll()"><i class="fas fa-expand-alt"></i> 展开</button>
      <button onclick="collapseAll()"><i class="fas fa-compress-alt"></i> 折叠</button>
      <button onclick="location.reload()"><i class="fas fa-sync-alt"></i> 刷新</button>
      <a href="/api/logs/export?<%= exportQuery %>&format=csv" class="export-btn csv"><i class="fas fa-file-csv"></i> CSV</a>
      <a href="/api/logs/export?<%= exportQuery %>&format=json" class="export-btn json"><i class="fas fa-file-code"></i> JSON</a>
    </div>
  </section>

  <div class="view-toggle">
    <button class="active" data-view="session" onclick="switchView('session')">会话视图</button>
    <button data-view="detail" onclick="switchView('detail')">明细视图</button>
  </div>

  <% function opClass(op) {
    if (!op) return 'op-default';
    if (op.includes('上传')) return 'op-upload';
    if (op.includes('下载')) return 'op-download';
    if (op.includes('删除')) return 'op-delete';
    if (op.includes('创建')) return 'op-mkdir';
    if (op.includes('搜索')) return 'op-search';
    if (op.includes('预览')) return 'op-preview';
    return 'op-default';
  } %>

  <div id="sessionView" class="log-list">
    <% if (logs.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-clipboard-list"></i>
        <p>暂无访问日志</p>
      </div>
    <% } else { %>
      <%
        // 按 IP 折叠：一个 IP 一张卡，卡内是它在当前筛选下的全部操作（不再按 1 小时窗口切分）
        var sortedLogs = [...logs].sort(function(a, b) { return new Date(b.timestamp) - new Date(a.timestamp); });
        var groupMap = new Map();
        sortedLogs.forEach(function(log, index) {
          var logTime = new Date(log.timestamp).getTime();
          var internalIp = log.internalIp || '-';
          var externalIp = (log.externalIp && log.externalIp !== '-' && log.externalIp !== 'unknown') ? log.externalIp : '-';
          var deviceKey = externalIp !== '-' ? externalIp : internalIp;
          var g = groupMap.get(deviceKey);
          if (!g) {
            g = { deviceKey: deviceKey, internalIp: internalIp, externalIp: externalIp,
                  logs: [], index: 0, endTime: logTime, startTime: logTime };
            groupMap.set(deviceKey, g);
          }
          g.endTime = Math.max(g.endTime, logTime);
          g.startTime = Math.min(g.startTime, logTime);
          g.logs.push(Object.assign({}, log, { originalIndex: index }));
          if (internalIp !== '-') g.internalIp = internalIp;
        });
        var sessions = [];
        groupMap.forEach(function(g) { sessions.push(g); });
        sessions.sort(function(a, b) { return b.endTime - a.endTime; });
        sessions.forEach(function(g, i) { g.index = i; });
      %>

      <% sessions.forEach(function(session) { %>
        <% var opCounts = {}; %>
        <% session.logs.forEach(function(log) {
          var type = log.operation || log.method || 'other';
          opCounts[type] = (opCounts[type] || 0) + 1;
        }); %>

        <% var hasRealInternalIp = session.internalIp && session.internalIp !== '-' && session.internalIp !== '127.0.0.1' && session.internalIp !== session.externalIp; %>
        <% var isInternalNetwork = session.internalIp && (session.internalIp.startsWith('10.') || session.internalIp.startsWith('192.168.') || session.internalIp.startsWith('172.')); %>
        <% var showExt = session.externalIp && session.externalIp !== '-' && session.externalIp !== 'unknown'; %>

        <div class="session-card" data-session="<%= session.index %>" data-ip="<%= session.deviceKey %>">
          <div class="session-header" onclick="toggleSession(<%= session.index %>)">
            <i class="fas fa-chevron-right session-expand"></i>
            <div class="session-info">
              <div class="session-ip-row">
                <% if (hasRealInternalIp && isInternalNetwork) { %>
                  <span class="ip-badge internal"><span class="tag">内网</span> <%= session.internalIp %></span>
                <% } %>
                <% if (showExt) { %>
                  <span class="ip-badge external"><span class="tag">外网</span> <%= session.externalIp %></span>
                  <span class="ip-location" data-ip="<%= session.externalIp %>">查询中...</span>
                <% } else if (hasRealInternalIp && !isInternalNetwork) { %>
                  <span class="ip-badge external"><span class="tag">外网</span> <%= session.internalIp %></span>
                  <span class="ip-location" data-ip="<%= session.internalIp %>">查询中...</span>
                <% } else if (!hasRealInternalIp) { %>
                  <span class="ip-badge"><%= session.internalIp %></span>
                <% } %>
              </div>
              <div class="session-ops">
                <% Object.keys(opCounts).forEach(function(type) { %>
                  <span class="op-badge <%= opClass(type) %>"><%= type %> &times;<%= opCounts[type] %></span>
                <% }); %>
              </div>
            </div>
            <div class="session-meta">
              <span class="session-time hide-mobile"><%= session.logs[session.logs.length - 1].timestamp %> &rarr; <%= session.logs[0].timestamp %></span>
              <span class="session-count"><%= session.logs.length %></span>
            </div>
          </div>
          <div class="session-detail">
            <%
              var groupedLogs = [];
              session.logs.forEach(function(log) {
                var op = log.operation || log.method;
                var p = log.path || '-';
                var un = log.username || '';
                var nm = log.name || '';
                var last = groupedLogs[groupedLogs.length - 1];
                if (last && last.op === op && last.path === p && last.un === un && last.nm === nm) { last.count++; last.latestTime = log.timestamp; }
                else { groupedLogs.push({ op: op, path: p, un: un, nm: nm, count: 1, latestTime: log.timestamp, externalIp: log.externalIp }); }
              });
            %>
            <% groupedLogs.forEach(function(item) { %>
              <div class="detail-row">
                <span class="detail-time"><%= item.latestTime %></span>
                <span class="detail-op op-badge <%= opClass(item.op) %>"><%= item.op %><% if (item.count > 1) { %> <span class="count-badge">×<%= item.count %></span><% } %></span>
                <% if (item.un || item.nm) { %>
                  <span class="detail-user" style="font-size:12px;color:#409eff;white-space:nowrap;"><i class="fas fa-user"></i> <%= item.un %><% if (item.nm) { %>（<%= item.nm %>）<% } %></span>
                <% } %>
                <span class="detail-path"><%= item.path %></span>
                <% if (item.externalIp && item.externalIp !== '-' && item.externalIp !== 'unknown') { %>
                  <span class="detail-ip hide-mobile">[<%= item.externalIp %>]</span>
                <% } %>
              </div>
            <% }); %>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <div id="detailView" style="display:none">
    <% if (logs.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-clipboard-list"></i>
        <p>暂无访问日志</p>
      </div>
    <% } else { %>
      <div class="log-table-wrapper">
        <table class="log-table">
          <thead>
            <tr>
              <th>时间</th>
              <th>操作</th>
              <th>路径</th>
              <th class="hide-mobile">内网 IP</th>
              <th class="hide-mobile">外网 IP</th>
              <th class="hide-mobile">地域</th>
              <th class="hide-mobile">登录用户</th>
              <th>登录类型</th>
            </tr>
          </thead>
          <tbody>
            <%
              var groupedLogs = [];
              [...logs].sort(function(a, b) { return new Date(b.timestamp) - new Date(a.timestamp); }).forEach(function(log) {
                var op = log.operation || log.method, p = log.path || '-', iIp = log.internalIp || '-', eIp = log.externalIp || '-', lt = log.loginType || '';
                var un = log.username || '', nm = log.name || '';
                var last = groupedLogs[groupedLogs.length - 1];
                if (last && last.op===op && last.path===p && last.iIp===iIp && last.eIp===eIp && last.lt===lt && last.un===un && last.nm===nm) { last.count++; last.latestTime = log.timestamp; }
                else { groupedLogs.push({ op:op, path:p, iIp:iIp, eIp:eIp, lt:lt, un:un, nm:nm, count:1, latestTime:log.timestamp }); }
              });
            %>
            <% groupedLogs.forEach(function(item) { %>
              <tr>
                <td><%= item.latestTime %></td>
                <td><span class="op-badge <%= opClass(item.op) %>"><%= item.op %><% if (item.count > 1) { %> <span class="count-badge">×<%= item.count %></span><% } %></span></td>
                <td><%= item.path %></td>
                <td class="hide-mobile"><%= item.iIp %></td>
                <td class="hide-mobile"><%= item.eIp %></td>
                <td class="hide-mobile"><% if (item.eIp && item.eIp !== '-' && item.eIp !== 'unknown') { %><span class="ip-location" data-ip="<%= item.eIp %>">-</span><% } else { %>-<% } %></td>
                <td class="hide-mobile"><% if (item.un || item.nm) { %><%= item.un %><% if (item.nm) { %>（<%= item.nm %>）<% } %><% } %></td>
                <td><%= item.lt %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <% if (totalPages > 1) { %>
  <div class="pagination">
    <% var pgWindow = 2; var startPage = Math.max(1, currentPage - pgWindow); var endPage = Math.min(totalPages, currentPage + pgWindow); %>
    <% if (currentPage > 1) { %>
      <a href="/logs?date=<%= dateFilter %>&page=<%= currentPage - 1 %>&limit=<%= limit %><%- showApi ? '&showApi=1' : '' %>" class="page-btn"><i class="fas fa-angle-left"></i></a>
    <% } else { %>
      <span class="page-btn disabled"><i class="fas fa-angle-left"></i></span>
    <% } %>
    <% for (var p = startPage; p <= endPage; p++) { %>
      <a href="/logs?date=<%= dateFilter %>&page=<%= p %>&limit=<%= limit %><%- showApi ? '&showApi=1' : '' %>" class="page-btn <%= p === currentPage ? 'active' : '' %>"><%= p %></a>
    <% } %>
    <% if (currentPage < totalPages) { %>
      <a href="/logs?date=<%= dateFilter %>&page=<%= currentPage + 1 %>&limit=<%= limit %><%- showApi ? '&showApi=1' : '' %>" class="page-btn"><i class="fas fa-angle-right"></i></a>
    <% } else { %>
      <span class="page-btn disabled"><i class="fas fa-angle-right"></i></span>
    <% } %>
    <div class="page-info">第 <%= currentPage %> / <%= totalPages %> 页 &middot; 共 <%= total %> 条</div>
  </div>
  <% } %>

</div>

<script>
function changeDate(value) {
  window.location.href = '/logs?date=' + value + '&limit=<%= limit %>';
}

// 跳转参数与筛选逻辑见上方 gotoLogs / toggleOnlyError / toggleShowApi / searchAll

function toggleSession(idx) {
  var card = document.querySelector('[data-session="' + idx + '"]');
  if (!card) return;
  var detail = card.querySelector('.session-detail');
  var icon = card.querySelector('.session-expand');
  if (detail.classList.contains('open')) {
    detail.classList.remove('open');
    icon.classList.remove('expanded');
  } else {
    detail.classList.add('open');
    icon.classList.add('expanded');
    loadIpLocationsInCard(card);
  }
}

function expandAll() {
  document.querySelectorAll('.session-detail').forEach(function(d) { d.classList.add('open'); });
  document.querySelectorAll('.session-expand').forEach(function(i) { i.classList.add('expanded'); });
  document.querySelectorAll('.session-card').forEach(function(c) { loadIpLocationsInCard(c); });
}

function collapseAll() {
  document.querySelectorAll('.session-detail').forEach(function(d) { d.classList.remove('open'); });
  document.querySelectorAll('.session-expand').forEach(function(i) { i.classList.remove('expanded'); });
}

function switchView(view) {
  document.querySelectorAll('.view-toggle button').forEach(function(btn) { btn.classList.remove('active'); });
  document.querySelector('.view-toggle button[data-view="' + view + '"]').classList.add('active');
  document.getElementById('sessionView').style.display = view === 'session' ? 'flex' : 'none';
  document.getElementById('detailView').style.display = view === 'detail' ? 'block' : 'none';
}

function filterByOp(value) {
  document.querySelectorAll('.session-card').forEach(function(card) {
    if (value === 'all') { card.style.display = 'block'; return; }
    var badges = card.querySelectorAll('.session-ops .op-badge');
    var match = false;
    badges.forEach(function(badge) {
      if (badge.textContent.includes(value)) match = true;
    });
    card.style.display = match ? 'block' : 'none';
  });
  document.querySelectorAll('.log-table tbody tr').forEach(function(row) {
    if (value === 'all') { row.style.display = ''; return; }
    var opCell = row.querySelector('.op-badge');
    row.style.display = (opCell && opCell.textContent.includes(value)) ? '' : 'none';
  });
}

function filterBySearch(value) {
  var q = value.toLowerCase().trim();
  document.querySelectorAll('.session-card').forEach(function(card) {
    if (!q) { card.style.display = 'block'; return; }
    card.style.display = card.textContent.toLowerCase().includes(q) ? 'block' : 'none';
  });
  document.querySelectorAll('.log-table tbody tr').forEach(function(row) {
    if (!q) { row.style.display = ''; return; }
    row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
}

var IP_COUNTS = <%- JSON.stringify(ipCounts || {}) %>;
var REGION_MAP = new Map();
var regionFilter = null;
var PARAM_LIMIT = '&limit=<%- limit %>';
var PARAM_ONLYERR = <%- onlyError ? "'&onlyError=1'" : "''" %>;
var PARAM_SHOWAPI = <%- showApi ? "'&showApi=1'" : "''" %>;

// 本机/回环地址不查地域（外网接口对 127.0.0.1 一律返回查询失败）
function localLabel(ip) {
  return (ip === '127.0.0.1' || ip === '::1' || ip === 'localhost') ? '本机' : null;
}

function gotoLogs(params) {
  var box = document.getElementById('searchBox');
  var p = PARAM_LIMIT + params;
  if (box && box.value) p += '&q=' + encodeURIComponent(box.value);
  window.location.href = '/logs?date=<%- dateFilter %>' + p;
}

function toggleShowApi(checked) {
  gotoLogs(PARAM_ONLYERR + (checked ? '&showApi=1' : ''));
}

function toggleOnlyError(checked) {
  gotoLogs(PARAM_SHOWAPI + (checked ? '&onlyError=1' : ''));
}

function searchAll() {
  gotoLogs(PARAM_SHOWAPI + PARAM_ONLYERR);
}

async function resolveAllLocations() {
  var els = Array.prototype.slice.call(document.querySelectorAll('.ip-location[data-ip]'));
  var ips = [];
  els.forEach(function(el) {
    var ip = el.dataset.ip;
    if (ip && ip !== '-' && ip !== 'unknown' && ips.indexOf(ip) === -1) ips.push(ip);
  });
  var idx = 0;
  async function worker() {
    while (idx < ips.length) {
      var ip = ips[idx++];
      var loc = localLabel(ip) || await queryIpLocation(ip);
      REGION_MAP.set(ip, loc);
      els.forEach(function(el) { if (el.dataset.ip === ip) el.textContent = loc; });
    }
  }
  var workers = [];
  for (var i = 0; i < 3; i++) workers.push(worker());
  await Promise.all(workers);
}

async function buildRegionCard() {
  var ips = Object.keys(IP_COUNTS).filter(function(ip) { return ip && ip !== '-' && ip !== 'unknown'; });
  if (!ips.length) return;
  ips.sort(function(a, b) { return IP_COUNTS[b] - IP_COUNTS[a]; });
  var top = ips.slice(0, 20);
  document.getElementById('regionCard').style.display = 'block';
  var list = document.getElementById('regionList');
  list.innerHTML = '<div style="color:#909399;font-size:13px;">地域查询中...</div>';
  var idx = 0;
  async function worker() {
    while (idx < top.length) {
      var ip = top[idx++];
      var loc = localLabel(ip) || await queryIpLocation(ip);
      REGION_MAP.set(ip, loc);
    }
  }
  var workers = [];
  for (var i = 0; i < 3; i++) workers.push(worker());
  await Promise.all(workers);

  var byRegion = {};
  top.forEach(function(ip) {
    var r = REGION_MAP.get(ip) || '未知';
    if (!byRegion[r]) byRegion[r] = { count: 0, ips: [] };
    byRegion[r].count += IP_COUNTS[ip];
    byRegion[r].ips.push(ip);
  });
  var regions = Object.keys(byRegion).map(function(r) { return { name: r, count: byRegion[r].count, ips: byRegion[r].ips }; })
    .sort(function(a, b) { return b.count - a.count; });
  list.innerHTML = '';
  regions.forEach(function(r, i) {
    var div = document.createElement('div');
    div.className = 'ranking-item';
    div.style.cursor = 'pointer';
    div.title = r.ips.join(', ');
    div.setAttribute('data-region', r.name);
    div.innerHTML = '<span class="ranking-index">' + (i + 1) + '.</span>' +
      '<span class="ranking-path">' + r.name + '</span>' +
      '<span class="ranking-count">' + r.count + ' 次 / ' + r.ips.length + ' 个 IP</span>';
    div.onclick = function() { filterByRegion(r.name); };
    list.appendChild(div);
  });
  var rest = ips.length - top.length;
  if (rest > 0) {
    var more = document.createElement('div');
    more.style.cssText = 'font-size:12px;color:#909399;padding:4px 0;';
    more.textContent = '另有 ' + rest + ' 个低频 IP 未查询地域';
    list.appendChild(more);
  }
}

function filterByRegion(region) {
  regionFilter = (regionFilter === region) ? null : region;
  document.querySelectorAll('.session-card').forEach(function(card) {
    card.style.display = (!regionFilter || REGION_MAP.get(card.dataset.ip) === regionFilter) ? 'block' : 'none';
  });
  document.querySelectorAll('.log-table tbody tr').forEach(function(row) {
    var el = row.querySelector('.ip-location[data-ip]');
    var ip = el ? el.dataset.ip : '';
    row.style.display = (!regionFilter || REGION_MAP.get(ip) === regionFilter) ? '' : 'none';
  });
  document.querySelectorAll('#regionList .ranking-item').forEach(function(item) {
    item.style.background = (item.getAttribute('data-region') === regionFilter) ? 'rgba(64,158,255,.15)' : '';
  });
}
var locationCache = new Map();
async function queryIpLocation(ip) {
  if (locationCache.has(ip)) return locationCache.get(ip);
  try {
    var response = await fetch('/api/ip-location/' + encodeURIComponent(ip));
    var data = await response.json();
    var location = data.location || '未知';
    locationCache.set(ip, location);
    return location;
  } catch (e) {
    locationCache.set(ip, '查询失败');
    return '查询失败';
  }
}

async function loadIpLocationsInCard(card) {
  var elements = card.querySelectorAll('.ip-location[data-ip]');
  for (var i = 0; i < elements.length; i++) {
    var el = elements[i];
    var ip = el.dataset.ip;
    if (!ip || ip === '-') continue;
    if (locationCache.has(ip)) {
      el.textContent = locationCache.get(ip);
    } else {
      el.textContent = '查询中...';
      var location = await queryIpLocation(ip);
      el.textContent = location;
    }
  }
}

document.addEventListener('DOMContentLoaded', function() {
  // 按 IP 去重查询地域（会话卡片 + 明细表），再生成地域分布卡片
  resolveAllLocations().then(function() { return buildRegionCard(); }).catch(function() {});
});

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') collapseAll();
});
</script>
</body>
</html>