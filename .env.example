# ===========================================================================
# 文件管理器环境变量配置 - 示例文件
# ===========================================================================
# 使用方法：
#   1. 复制此文件为 .env:  copy .env.example .env
#   2. 修改 .env 里的值（特别是 ADMIN_PASSWORD_HASH 和 SESSION_SECRET）
#   3. 重启 PM2 服务:  pm2 restart ecosystem.config.js
#
# .env 文件不会随 git 提交（已在 .gitignore 中忽略）
# ===========================================================================

# 服务器端口
PORT=3000

# 上传目录（绝对路径）
UPLOAD_DIR=D:\Web\uploads

# 日志目录
LOG_DIR=D:\Web\logs

# 回收站目录
RECYCLE_DIR=D:\Web\.trash

# 管理员账号
ADMIN_USERNAME=admin

# 管理员密码哈希（bcrypt）
# ---------------------------------------------------------------------------
# 生效优先级（config.js）：
#   1. runtime-config.json -> admin.passwordHash   ← 运行时真正的来源
#      用户首次在登录页用“修改密码”功能改密码时，新哈希会写到这里。
#   2. ADMIN_PASSWORD_HASH 环境变量（即此 .env）      ← 仅作兜底
#   3. 空字符串                                      ← 登录将被拒绝
#
# 全新部署建议：此处留空，首次启动后用登录页“修改密码”功能设密码，
# 新哈希自动写入 runtime-config.json，比把哈希留在 .env 更安全。
# 若坚持用 .env 作唯一来源，先生成哈希：
#   cd D:\Web\file-manager
#   node -e "console.log(require('bcryptjs').hashSync('你的密码', 10))"
ADMIN_PASSWORD_HASH=$2a$10$YourHashedPasswordHere

# 会话密钥（用于加密 session cookie，请修改为一个随机字符串）
# 生成新的随机密钥：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=your-secret-key-change-this

# 可选：管理员 IP 白名单（多个用逗号分隔，留空表示允许所有）
# ALLOWED_ADMIN_IPS=127.0.0.1,192.168.1.100

# 生产环境标识
NODE_ENV=production
