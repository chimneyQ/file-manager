# ===== 文件管理器环境变量模板 =====
# 用法：cp .env.example .env 后按需修改；.env 已在 .gitignore，不会入库。
# 所有变量都可以不设 —— 不设时用 config.js 的默认值（目录默认在项目内）。

# 监听端口
PORT=3000

# production 会关闭控制台日志；排查问题时改成 development
NODE_ENV=production

# 会话签名密钥
# 留空时首次启动会自动生成并写入 runtime-config.json（多实例部署必须显式设置且各实例一致）
# 生成方式： npm run gen:secret
SESSION_SECRET=

# ===== 目录（可写相对路径或绝对路径）=====
# 上传根目录（默认 ./uploads）
# UPLOAD_DIR=./uploads
# 日志与会话目录（默认 ./logs）
# LOG_DIR=./logs
# 回收站目录（默认 ./.trash）
# RECYCLE_DIR=./.trash

# ===== 管理员 =====
# 用户名（默认 admin）
# ADMIN_USERNAME=admin
# 密码的 bcrypt 哈希；留空则首次启动自动生成随机初始密码并打印到控制台
# 手工生成： node -e "console.log(require('bcryptjs').hashSync('你的密码', 10))"
ADMIN_PASSWORD_HASH=

# 管理后台 IP 白名单，逗号分隔；留空 = 不限制
# ALLOWED_ADMIN_IPS=127.0.0.1,192.168.1.100

# ===== 存储配额与告警（GB / 毫秒，0 = 不限制或关闭）=====
# UPLOAD_PRIVATE_QUOTA_GB=5
# UPLOAD_TOTAL_WARN_GB=45
# UPLOAD_TOTAL_LIMIT_GB=0
# UPLOAD_SCAN_INTERVAL_MS=21600000

