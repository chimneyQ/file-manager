# 环境变量文件（包含敏感凭据，绝不能提交）
.env
.env.local
.env.*.local

# 运行时配置（前端“修改密码”会写入）
runtime-config.json
runtime-config.json.bak

# 备份文件
*.bak
*.bak-*
*.pre-*.bak
*.before-*.bak

# 日志（PM2 日志与应用日志，默认都落在项目内的 logs/）
logs-stderr.log
logs-stdout.log

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 用户数据库（含密码哈希与手机号，绝不能提交）
data/users.json

# 运行时数据与临时产物
data/*.bak*
data/users.json.*
# 分享链接表含明文 token，等价于访问凭据，不入库
data/share-links.json
uploads/
.tmp-*
_t*.js
*.pid

# 系统/编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# 运行期目录（默认都在项目内，不入库）
logs/
uploads/
.trash/
sessions/
*.log

# 环境变量未展开时误建的垃圾目录（内含机器本地面部识别数据，非项目内容）
%SystemDrive%/
