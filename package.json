{
  "name": "self-hosted-file-manager",
  "version": "1.1.0",
  "description": "自托管文件管理器：上传下载、在线预览、回收站、分享链接、多用户与配额（Express + EJS，零外部依赖服务）",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "gen:secret": "node scripts/gen-secret.js",
    "docker:build": "docker build -t file-manager .",
    "docker:up": "docker compose up -d",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.17.3",
    "fs-extra": "^11.4.0",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "file-manager",
    "self-hosted",
    "express",
    "upload",
    "lan",
    "h5ai"
  ],
  "private": true
}
